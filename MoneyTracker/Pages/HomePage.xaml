<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="HomePageBind"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoneyTracker.Pages.HomePage"
             xmlns:viewmodel="clr-namespace:MoneyTracker.ViewModels"
             xmlns:DataType="viewmodel:HomeViewModel"
             Shell.FlyoutBehavior="Flyout"
             Appearing="HomePageBind_Appearing">

    <!--#region Toolbar-->
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Charts"
            Command="{Binding ChartCommand}"/>
        <ToolbarItem
            Text="Quick Add"
            Command="{Binding QuickAddCommand}"/>
        <ToolbarItem
            Text="Logout"                     
            Command="{Binding LogoutCommand}"/>
    </ContentPage.ToolbarItems>
    <!--#endregion-->
    <!--#region Scrollview-->
    <ScrollView x:Name="HomeScroll" VerticalScrollBarVisibility="Never">
        <Grid RowDefinitions="auto,auto,auto,auto,auto,*,auto">
            <Grid RowSpacing="10"
                  Grid.Row="0"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  VerticalOptions="CenterAndExpand"
                HorizontalOptions="FillAndExpand">
                <!--#region Financial Overview-->
                <Frame 
                    WidthRequest="{Binding Width}">
                    <Grid ColumnDefinitions="auto,*,auto,*,auto"
                          HorizontalOptions="StartAndExpand"
                          RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto"
                          RowSpacing="10">
                        <!-- Row 0 -->
                        <Label Text="Pay:    "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="0"/>
                        <Label Text="{Binding CurrentIncome, StringFormat='${0}'}"
                               TextColor="{AppThemeBinding Dark=white, Light=black,Default=grey}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="0"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>

                        <!-- Row 1 -->
                        <Label Text="Bills:  "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="1"/>
                        <Label Text="{Binding CurrentExpenses, StringFormat='${0}'}"
                               TextColor="{AppThemeBinding Dark=white, Light=black,Default=grey}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="1"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>

                        <!-- Row 2 -->
                        <Label Text="{Binding Balance, StringFormat='${0}'}"
                               TextColor="{Binding BalanceColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="2"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>
                        
                        <!-- Row 3 -->
                        <Label Text="Checking:    "
                               FontSize="Medium" 
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="3"/>
                        <Label Text="{Binding CurrentChecking, StringFormat='${0}'}"
                               TextColor="{Binding CurrentCheckingColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="3"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>

                        <!-- Row 4 -->
                        <Label Text="Savings:   "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="4"/>
                        <Label Text="{Binding CurrentSavings, StringFormat='${0}'}"
                               TextColor="{Binding CurrentSavingsColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="4"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>

                        <!-- Row 5 -->
                        <Label Text="Credit:   "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="5"/>
                        <Label Text="{Binding CurrentCredit, StringFormat='${0}'}"
                               TextColor="{Binding CurrentCreditColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="5"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>
                        
                        <!-- Row 6 -->
                        <Label Text="Debt:  "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="6"/>
                        <Label Text="{Binding CurrentLoans, StringFormat='${0}'}"
                               TextColor="{Binding CurrentDebtColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="6"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>
                        
                        <!-- Row 7 -->
                        <Label Text="Total Balance: "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="7"/>
                        <Label Text="{Binding TotalBalance, StringFormat='${0}'}"
                               TextColor="{Binding TotalBalanceColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="7"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>

                        <!-- Row 8 -->
                        <Label Text="Net Worth: "
                               FontSize="Medium"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Grid.Column="1"
                               Grid.Row="8"/>
                        <Label Text="{Binding CurrentNetWorth, StringFormat='${0}'}"
                               TextColor="{Binding CurrentNetWorthColor}"
                               FontSize="Medium"
                               Grid.Column="2"
                               Grid.Row="8"
                               HorizontalOptions="End"
                               Grid.ColumnSpan="2"
                               VerticalOptions="End"/>
                    </Grid>
                </Frame>
                <!--#endregion-->
                <!--#region Accounts-->
                <Frame Grid.Row="1">
                    <Grid RowDefinitions="auto,auto,auto,auto">
                        <Label Text="{Binding AccountHeader}"
                               FontSize="Medium"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <ListView x:Name="AccountListView"
                            ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                    ItemSelected="ListView_AccountSelected"
                                  SelectionMode="Single"
                                  Grid.Row="1">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid ColumnDefinitions="*,auto,auto,auto,auto,*"
                                              RowDefinitions=".25*,auto,auto,.25*"
                                              RowSpacing="2"
                                              ColumnSpacing="10">
                                            <Label Text="Name"
                                                   Grid.Column="1"
                                                   Grid.Row="1"
                                                   FontSize="Small"/>
                                            <Label Text="{Binding Name}"
                                                   Grid.Column="1"
                                                   Grid.Row="2"
                                                   FontSize="Small"/>
                                            <Label Text="Last 4 of Acct Num"
                                                    Grid.Column="2"
                                                    Grid.Row="1"
                                                    FontSize="Small"/>
                                            <Label Text="{Binding LastFourDigits}"
                                                    Grid.Column="2"
                                                    Grid.Row="2"
                                                    FontSize="Small"/>
                                            <Label Text="Balance"
                                                    Grid.Column="3"
                                                    Grid.Row="1"
                                                    FontSize="Small"/>
                                            <Label Text="{Binding Balance, StringFormat='${0}'}"
                                                   Grid.Row="2"
                                                    Grid.Column="3"
                                                   FontSize="Small"/>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Frame>
                <!--#endregion-->
                <!--#region Loans-->
                <Frame Grid.Row="2">
                    <Grid RowDefinitions="auto,*,auto,auto"
                          RowSpacing="10">
                        <Label Text="{Binding LoanHeader}"
                            FontSize="Medium"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                        <ListView x:Name="LoanListView"
                            ItemsSource="{Binding Loans}"
                            SelectedItem="{Binding SelectedLoan}"
                            ItemSelected="ListView_ItemSelected"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid ColumnDefinitions="*,auto,auto,auto,auto,*"
                                              RowDefinitions=".25*,auto,auto,.25*"
                                              RowSpacing="2"
                                              ColumnSpacing="10">
                                            <Label Text="Name"
                                                   Grid.Column="1"
                                                   Grid.Row="1"
                                                   FontSize="Small"/>
                                            <Label Text="{Binding Name}"
                                                   Grid.Column="1"
                                                   Grid.Row="2"
                                                   FontSize="Small"/>
                                            <Label Text="Payment"
                                                   Grid.Column="2"
                                                   Grid.Row="1"
                                                   FontSize="Small"/>
                                            <Label Text="{Binding MonthlyPayment, StringFormat='${0}'}"
                                                   Grid.Column="2"
                                                   Grid.Row="2"
                                                   FontSize="Small"/>
                                            <Label Text="Due Date"
                                                   Grid.Column="3"
                                                   Grid.Row="1"
                                                   FontSize="Small"/>
                                            <Label Text="{Binding DueDate, StringFormat='{0:MM/dd/yyyy}'}"
                                                   Grid.Column="3"
                                                   Grid.Row="2"
                                                   FontSize="Small"/>
                                            <Label Text="Balance"
                                                   Grid.Column="4"
                                                   Grid.Row="1"
                                                   FontSize="Small"/>
                                            <Label Text="{Binding RemainingBalance, StringFormat='${0}'}" 
                                                   Grid.Column="4"
                                                   Grid.Row="2"/>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Frame>
                <!--#endregion-->
                <!--#region Auto Pays-->
                <Frame Grid.Row="3">
                    <Grid RowDefinitions="auto,auto,auto,auto">
                        <Label Text="{Binding AutoHeader}"
            FontSize="Medium"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
                        <ListView ItemsSource="{Binding Autos}"
            SelectedItem="{Binding SelectedAutoPay}"
            SelectionMode="Single"
            RowHeight="50">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="{Binding AutoPay.AutoPayName}"
                                FontSize="Small"/>
                                            <Label Text="{Binding AutoPay.AutoPay, StringFormat='${0}'}"
                                FontSize="Small"/>
                                            <Label Text="{Binding AutoPay.AutoPayDate}"
                                FontSize="Small"/>
                                            <Label Text="{Binding AutoPay.AutoPayActive}"
                                FontSize="Small"/>
                                        </StackLayout>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Frame>
                <!--#endregion-->
                <!--#region Jobs-->
                <Frame Grid.Row="4">
                    <Grid RowDefinitions="auto,auto,auto,auto"
                          RowSpacing="10">
                        <Label Text="{Binding JobHeader}"
                            FontSize="Medium"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                        <ListView Grid.Row="1"
                            ItemsSource="{Binding Jobs}"
                            SelectedItem="{Binding SelectedJob}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ScrollView>
                                            <Grid ColumnDefinitions=".5*,.5*,.5*"
                                              RowDefinitions="auto,auto">
                                                <Label Grid.Column="0"
                                                Text="{Binding Company}"
                                                FontSize="Small"/>
                                                <Label Grid.Column="1"
                                                Text="{Binding Title}"
                                                FontSize="Small"/>
                                                <Label Grid.Column="2"
                                                Text="{Binding PayCheckAmount, StringFormat='Paycheck: ${0}'}"
                                                FontSize="Small"/>
                                            </Grid>
                                        </ScrollView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Frame>
                <!--#endregion-->
                <!--#region Quick Add-->
                <Frame x:Name="QuickAddFrame" IsVisible="{Binding QuickAddVis}" Grid.Row="4">
                    <Grid RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Frame BackgroundColor="Transparent">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions=".6*, .3*"
                                    RowSpacing="10"
                                    ColumnSpacing="25">
                                <Entry Placeholder="$0.00"
                                       Keyboard="Numeric"
                                       Text="{Binding AddTransactionM.Amount}"/>
                                <Entry Placeholder="Name"
                                       Keyboard="Text"
                                       Text="{Binding AddTransactionM.Name}"
                                       Grid.Row="1"/>
                                <DatePicker Date="{Binding AddTransactionM.TransactionDate}" 
                                            Grid.Row="2"/>
                                <Label Text="Add Transaction"
                                       Grid.Column="1"
                                       VerticalTextAlignment="Center"/>
                                <Button Text="Save"
                                       Command="{Binding AddTransactionCommand}" 
                                       Grid.Row="2"
                                       Grid.Column="1"/>
                            </Grid>
                        </Frame>
                        <Frame BackgroundColor="Transparent" Grid.Row="1">
                            <Grid RowDefinitions="Auto,Auto"
                                    ColumnDefinitions=".6*, .3*"
                                    RowSpacing="10"
                                    ColumnSpacing="25">
                                <Entry Placeholder="Foo account"
                                        Keyboard="Text"
                                        Text="{Binding AddAccountM.AccountName}"/>
                                <Entry Placeholder="Account Number"
                                        Keyboard="Text"
                                        Text="{Binding AddAccountM.AccountNumber}"
                                        Grid.Row="1"/>
                                <Label Text="Add Account"
                                        Grid.Column="1"
                                        VerticalTextAlignment="Center"/>
                                <Button Text="Save"
                                        Command="{Binding AddAccountCommand}" 
                                        Grid.Row="1"
                                        Grid.Column="1"/>
                            </Grid>
                        </Frame>
                        <Frame BackgroundColor="Transparent" Grid.Row="2">
                            <Grid RowDefinitions="Auto,Auto"
                                    ColumnDefinitions=".6*, .3*"
                                    RowSpacing="10"
                                    ColumnSpacing="25">
                                <Entry Placeholder="$0.00"
                                        Keyboard="Numeric"
                                        Text="{Binding AddLoanM.LoanAmount}"/>
                                <Entry Placeholder="Name"
                                       Keyboard="Text"
                                       Text="{Binding AddLoanM.LoanName}"
                                       Grid.Row="1"/>
                                <Label Text="Add Loan"
                                       Grid.Column="1"
                                       VerticalTextAlignment="Center"/>
                                <Button Text="Save"
                                       Command="{Binding AddLoanCommand}" 
                                       Grid.Row="1"
                                       Grid.Column="1"/>
                            </Grid>
                        </Frame>
                        <StackLayout Grid.Row="3">
                            <Button 
                                Text="{Binding ButtonText}" 
                                TextColor="{Binding TextColor}"
                                Command="{Binding QuickAddCommand}"/>
                        </StackLayout>
                    </Grid>
                </Frame>
                <!--#endregion-->
            </Grid>
        </Grid>
    </ScrollView>
    <!--#endregion-->
</ContentPage>