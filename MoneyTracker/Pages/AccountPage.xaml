<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="AccountPageBind"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoneyTracker.Pages.AccountPage"
             xmlns:DataType="viewmodel:AccountViewModel"
             Title="Accounts">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding AddAccountText}" Command="{Binding AddAccountCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="auto,auto,auto,auto"
          RowSpacing="5"
          ColumnDefinitions="auto,auto,auto"
          ColumnSpacing="10">
        <Label Grid.Column="1" HorizontalOptions="CenterAndExpand" FontSize="Large" MaximumWidthRequest="{Binding Width}" Text="{Binding Message}"/>
        <ScrollView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4">
            <CollectionView ItemsSource="{Binding Accounts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" Command="{Binding BindingContext.DeleteAccountCommand, Source={x:Reference AccountPageBind}}" CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Edit" Command="{Binding BindingContext.EditAccountCommand, Source={x:Reference AccountPageBind}}" CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <SwipeView.Content>
                                <Grid RowDefinitions="auto,auto,auto"
                                      RowSpacing="5"
                                      ColumnDefinitions="auto,auto,auto,auto,auto"
                                      ColumnSpacing="10">
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding Provider}"/>
                                    <Label Grid.Row="0" Grid.Column="3" Text="{Binding Balance}"/>
                                </Grid>
                            </SwipeView.Content>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
        <Frame Grid.Row="3" BackgroundColor="Transparent" MaximumWidthRequest="{Binding Width}" IsVisible="{Binding AddAccountVisible}" BorderColor="{AppThemeBinding Dark=White, Light=black, Default=grey}">
            <Grid RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto"
              RowSpacing="5"
              ColumnDefinitions=".25*,auto,*,.25*"
              HorizontalOptions="Center" VerticalOptions="Center">
                <Label Grid.Column="1" Text="Name: "/>
                <Entry Grid.Column="2" Placeholder="My Checking" Text="{Binding Name}"/>
                <Label Grid.Column="1" Grid.Row="2" Text="Account Number: "/>
                <Entry Grid.Column="2" Grid.Row="2" Keyboard="Numeric" Placeholder="xxxxxxxxx1234" Text="{Binding FormattedAccountNumber}"/>
                <Label Grid.Column="1" Grid.Row="3" Text="Routing Number: "/>
                <Entry Grid.Column="2" Grid.Row="3" Keyboard="Numeric" Placeholder="01234567890" Text="{Binding RoutingNumber}"/>
                <Label Grid.Column="1" Grid.Row="4" Text="Provider: "/>
                <Entry Grid.Column="2" Grid.Row="4" Placeholder="Santander" Text="{Binding Provider}"/>
                <Label Grid.Column="1" Grid.Row="5" Text="Type: "/>
                <Entry Grid.Column="2" Grid.Row="5" Placeholder="Checking" Text="{Binding Type}"/>
                <Label Grid.Column="1" Grid.Row="6" Text="Balance:"/>
                <Entry Grid.Column="2" Grid.Row="6" Keyboard="Numeric" Placeholder="1.00" Text="{Binding Balance, StringFormat='${0:0.00}'}"/>
                <StackLayout Grid.Row="7" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="10">
                    <Button Text="Save" Command="{Binding SaveAccountCommand}"/>
                    <Button Text="Clear form" Command="{Binding ClearAccountCommand}"/>
                    <Button Text="Cancel" Command="{Binding AddAccountCommand}"/><!--This will hide the panel and reset the fields-->
                </StackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>